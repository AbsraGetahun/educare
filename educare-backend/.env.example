# EDUCARE Backend Configuration

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=absra123
DB_NAME=educare

# JWT
JWT_SECRET_KEY=educare-secret-key

# Email Configuration
EMAIL_MODE=console  # Options: console, smtp, sendgrid

# Console mode: Logs verification links to console
# SMTP mode: Uses Gmail SMTP
# SendGrid mode: Uses SendGrid API

# SMTP Settings (for EMAIL_MODE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@educare.com

# SendGrid Settings (for EMAIL_MODE=sendgrid)
SENDGRID_API_KEY=your-sendgrid-api-key

# Verification Settings
VERIFICATION_TOKEN_EXPIRY_HOURS=24

# Frontend URL (for verification links)
BASE_URL=http://localhost:3000